  "selection": {
    "method": "For every one of the 153 curated bursts with >=2 DNGs, choose lexicographically first and last payload_N*.dng. Rank candidates by combined source object size ascending, then burst ID ascending; keep the first 20. Exact object names and generations are frozen below.",
    "model_scores_used": false,
    "reason": "Keep source DNG transfer below a 300,000,000-byte ceiling while reaching 20 independently captured burst groups.",
    "size_bias": "Explicit size-based selection favors compressed/newer-camera 2016 bursts and less detailed/noisy content. This is a scoped reproducible evaluation set, not an unbiased dataset sample.",
    "frame_policy": "First and last captured raw files, rather than multiple renderings of a merged output.",
    "scene_policy": "Use the documented visually reviewed distinct scenes, with two overlapping-settings candidates excluded before inference.",
    "burst_count": 18,
    "frame_count": 36,
    "total_source_bytes": 250789472,
    "total_reference_jpeg_bytes": 80437785,
    "initialCandidateBursts": 20,
    "initialSourceBytes": 279559788,
    "review": "Assistant visual review of first-frame contact sheet before model inference, not independent human ground truth. Excluded two overlapping settings; no selection or labels use model scores. Distinct composition/time contexts are separate scene labels; shared broad subject matter is not a same-scene label.",
    "excluded": [
      {
        "burst": "5066_20160413_171343_904",
        "reason": "Visually related to sea-cave/beach burst 5066_20160413_170521_051; avoid assuming cross-burst negative ground truth."
      },
      {
        "burst": "5066_20160504_181920_148",
        "reason": "Same restaurant setting as bottle-foreground burst 5066_20160504_184741_899; avoid assuming cross-burst negative ground truth."
      }
    ]
  },
  "rendering": {
    "description": "Derived from separate raw burst frames: rawpy half-size camera-white-balance development without auto-brightening, orientation from source metadata, 8-bit sRGB, gamma (2.222, 4.5), Lanczos downscale to maximum 512 pixels, lossless PNG. No merged HDR output is an evaluation frame.",
    "python": "3.12",
    "rawpy": "0.25.1",
    "numpy": "2.2.6",
    "Pillow": "11.3.0",
    "platform": "Linux x86_64",
    "OMP_NUM_THREADS": "1",
    "half_size": true,
    "use_camera_wb": true,
    "no_auto_bright": true,
    "output_bps": 8,
    "output_color": "sRGB",
    "gamma": [
      2.222,
      4.5
    ],
    "max_dimension": 512,
    "resize": "Pillow LANCZOS",
    "format": "PNG",
    "compress_level": 6,
    "optimize": false
  },
