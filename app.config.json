{
  "$schema": "./schemas/app-config.schema.json",
  "name": "Best Shot Picker",
  "nameJa": "ベストショット選び",
  "slug": "best-shot-picker",
  "version": "0.7.0",
  "description": "Compare photos, choose your favorites, and save the untouched originals in a ZIP.",
  "descriptionJa": "写真を見比べてお気に入りを選び、元ファイルのままZIPで保存。",
  "defaultLanguage": "auto",
  "repository": {
    "owner": "ttomohisa",
    "name": "htmlapps-best-shot-picker"
  },
  "build": {
    "output": "dist/index.html",
    "blockRuntimeNetwork": true,
    "selfExtract": {
      "enabled": true,
      "output": "dist/index.self-extract.html"
    },
    "sizeBudget": {
      "readableWarningMb": 25,
      "selfExtractWarningMb": 12
    }
  }
}
